{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/johanlaogai/travel_guide_skill/schemas/trip.schema.json",
  "title": "travel-guide trip",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "meta", "days", "budget", "sources"],
  "$defs": {
    "guideBlock": {
      "type": "object",
      "required": ["title", "body", "sourceIds"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "sourceIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "meta": {
      "type": "object",
      "required": ["id", "title", "destination", "startDate", "endDate", "days", "travelers", "budget"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "destination": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "country": { "type": "string" },
            "admin1": { "type": "string" },
            "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
            "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
            "timezone": { "type": "string" },
            "coordSystem": { "const": "WGS84" }
          }
        },
        "origin": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "days": { "type": "integer", "minimum": 1 },
        "travelers": { "type": "integer", "minimum": 1 },
        "budget": {
          "type": "object",
          "required": ["currency"],
          "properties": {
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "level": { "enum": ["low", "mid", "high"] },
            "totalMin": { "type": ["number", "null"], "minimum": 0 },
            "totalMax": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "pace": { "enum": ["relaxed", "balanced", "packed"] },
        "interests": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "demo": { "type": "boolean" },
        "publicMode": { "type": "boolean" },
        "generatedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "generator": { "type": "string" }
      }
    },
    "overview": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "background": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "guide": {
          "type": "object",
          "properties": {
            "intro": { "$ref": "#/$defs/guideBlock" },
            "sections": {
              "type": "array",
              "items": { "$ref": "#/$defs/guideBlock" }
            },
            "food": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "description", "sourceIds"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "sourceIds": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "photoSpots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "area", "bestTime", "tip", "sourceIds"],
                "properties": {
                  "name": { "type": "string" },
                  "area": { "type": "string" },
                  "bestTime": { "type": "string" },
                  "tip": { "type": "string" },
                  "sourceIds": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "pitfalls": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "body", "severity", "category", "sourceIds"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                  "title": { "type": "string" },
                  "body": { "type": "string" },
                  "severity": { "enum": ["high", "medium", "low"] },
                  "category": { "enum": ["ticket", "transport", "scam", "health", "weather", "food", "custom"] },
                  "appliesTo": { "type": "array", "items": { "type": "string" } },
                  "sourceIds": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "tips": {
              "type": "array",
              "items": { "$ref": "#/$defs/guideBlock" }
            }
          }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "items"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "weekday": { "type": "string" },
          "title": { "type": "string" },
          "area": { "type": "string" },
          "weather": {
            "type": ["object", "null"],
            "required": ["sourceId"],
            "properties": {
              "sourceId": { "type": "string" },
              "summary": { "type": "string" },
              "weatherCode": { "type": "integer" },
              "high": { "type": "number" },
              "low": { "type": "number" },
              "precipitationProbability": { "type": "number", "minimum": 0, "maximum": 100 },
              "precipitationSum": { "type": "number", "minimum": 0 },
              "sunrise": { "type": "string" },
              "sunset": { "type": "string" },
              "updatedAt": { "type": "string" },
              "climate": { "type": "boolean" }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "start", "end", "title"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "enum": ["anchor", "meal", "transit", "rest", "hotel", "buffer"] },
                "start": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
                "end": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
                "title": { "type": "string", "minLength": 1 },
                "place": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "address": { "type": "string" },
                    "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
                    "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
                    "coordSystem": { "const": "WGS84" }
                  }
                },
                "transit": {
                  "type": "object",
                  "required": ["mode", "durationMin"],
                  "properties": {
                    "mode": { "enum": ["walk", "metro", "bus", "taxi", "drive", "train", "flight", "other"] },
                    "durationMin": { "type": "number", "minimum": 0 },
                    "distanceKm": { "type": "number", "minimum": 0 },
                    "fromPrevious": { "type": "boolean" },
                    "note": { "type": "string" }
                  }
                },
                "sourceIds": { "type": "array", "items": { "type": "string" } },
                "derived": { "type": "boolean" },
                "derivation": { "type": "string" },
                "detail": {
                  "type": "object",
                  "properties": {
                    "description": { "type": "string" },
                    "highlights": { "type": "array", "items": { "type": "string" } },
                    "photoTip": { "type": "string" }
                  }
                },
                "confidence": { "enum": ["official", "verified", "forecast", "community", "estimate", "unverified"] },
                "cost": {
                  "type": "object",
                  "required": ["amount", "currency"],
                  "properties": {
                    "amount": { "type": "number", "minimum": 0 },
                    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                    "category": { "type": "string" }
                  }
                },
                "booking": {
                  "type": "object",
                  "properties": {
                    "required": { "type": "boolean" },
                    "status": { "type": "string" },
                    "deadline": { "type": "string" },
                    "url": { "type": "string" },
                    "note": { "type": "string" }
                  }
                },
                "openingHours": { "type": "string" },
                "ticketPrice": { "type": "string" },
                "notes": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "area": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "why": { "type": "string" },
          "sourceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "budget": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "min", "max"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "min": { "type": "number", "minimum": 0 },
          "max": { "type": "number", "minimum": 0 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "sourceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "packing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "category": { "type": "string" },
          "essential": { "type": "boolean" }
        }
      }
    },
    "bookingChecklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "required": { "type": "boolean" },
          "status": { "type": "string" },
          "deadline": { "type": "string" },
          "url": { "type": "string" },
          "sourceIds": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "emergency": {
      "type": "object",
      "properties": {
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "redacted": { "type": "boolean" }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "source.schema.json" }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "policyVersion": { "type": "string" },
        "lastCheckedAt": { "type": ["string", "null"] }
      }
    }
  }
}
